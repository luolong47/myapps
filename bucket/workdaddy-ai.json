{
    "version": "1.2.2",
    "description": "WorkBuddy AI 桌面端增强助手（国际版）：自动签到领积分、多账号独立备份、点切即用；免打扰模式让 AI 无人值守跑长任务；跨账号会话迁移、异常中断自动续接。",
    "homepage": "https://github.com/babygoton/WorkDaddy",
    "license": "AGPL-3.0-or-later",
    "notes": [
        "便携版由 luolong47/WorkDaddy fork 基于上游同一 tag 源码构建，资产与上游 release 同步。",
        "需先安装 WorkBuddy AI 桌面端（workbuddy.ai）。"
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/luolong47/WorkDaddy/releases/download/v1.2.2/WorkDaddy-AI-Portable-1.2.2.zip",
            "hash": "c16428923ad5dab90637fc7421578241f1d363f5203b4589fbef5820b25dd3f6"
        }
    },
    "bin": "WorkDaddyLauncher.exe",
    "shortcuts": [
        [
            "WorkDaddyLauncher.exe",
            "WorkDaddy AI"
        ]
    ],
    "post_install": [
        "# scoop shortcuts 不支持 IconLocation；上游图标在独立 .ico（打包脚本保证其不随版本变化）",
        "$ws = New-Object -ComObject WScript.Shell",
        "$icon = \"$dir\\scripts\\WorkDaddy.ico\"",
        "Get-ChildItem \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\" -Recurse -Filter 'WorkDaddy AI.lnk' -ErrorAction SilentlyContinue | ForEach-Object { $s = $ws.CreateShortcut($_.FullName); $s.IconLocation = $icon; $s.Save() }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/luolong47/WorkDaddy/releases/latest",
        "regex": "\"tag_name\":\\s*\"v([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/luolong47/WorkDaddy/releases/download/v$version/WorkDaddy-AI-Portable-$version.zip",
                "hash": {
                    "url": "https://api.github.com/repos/luolong47/WorkDaddy/releases/latest",
                    "regex": "\"name\":\\s*\"WorkDaddy-AI-Portable-$version\\.zip\",[\\s\\S]*?\"digest\":\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    }
}
