{
    "version": "1.2.8",
    "description": "WorkBuddy AI 桌面端增强助手（国际版）：自动签到领积分、多账号独立备份、点切即用；免打扰模式让 AI 无人值守跑长任务；跨账号会话迁移、异常中断自动续接。",
    "homepage": "https://github.com/babygoton/WorkDaddy",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/babygoton/WorkDaddy/releases/download/1.2.8/WorkDaddy-AI-Portable-1.2.8.zip",
            "hash": "e47af332d9345a1ac03b83e4b9ffabe8ae99fa9dd1a173a52ddcfe2aa4a7462b"
        }
    },
    "bin": "WorkDaddyLauncher.exe",
    "shortcuts": [
        [
            "WorkDaddyLauncher.exe",
            "WorkDaddy AI"
        ]
    ],
    "post_install": [
        "# scoop shortcuts 不支持 IconLocation；上游图标固定在 scripts/WorkDaddy.ico（实测 1.2.4 / 1.2.5 内容一致）",
        "$ws = New-Object -ComObject WScript.Shell",
        "$icon = \"$dir\\scripts\\WorkDaddy.ico\"",
        "Get-ChildItem \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\" -Recurse -Filter 'WorkDaddy AI.lnk' -ErrorAction SilentlyContinue | ForEach-Object { $s = $ws.CreateShortcut($_.FullName); $s.IconLocation = $icon; $s.Save() }"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/babygoton/WorkDaddy/releases/latest",
        "regex": "\"tag_name\":\\s*\"([\\d.]+)\""
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/babygoton/WorkDaddy/releases/download/$version/WorkDaddy-AI-Portable-$version.zip",
                "hash": {
                    "url": "https://api.github.com/repos/babygoton/WorkDaddy/releases/tags/$version",
                    "regex": "\"name\":\\s*\"WorkDaddy-AI-Portable-$version\\.zip\",[\\s\\S]*?\"digest\":\\s*\"sha256:([a-f0-9]{64})\""
                }
            }
        }
    }
}
