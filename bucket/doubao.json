{
    "##": "豆包桌面客户端。官方安装器支持 --target_dir 直接指定安装目录，因此无需像 tabbit 那样装完再搬文件。安装后清理 LocalAppData 残留与注册表卸载项，实现绿色化。",
    "version": "2.29.10",
    "description": "Doubao - ByteDance AI assistant with a built-in AI browser",
    "homepage": "https://www.doubao.com/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://lf-flow-web-cdn.doubao.com/obj/flow-doubao/doubao_pc/2.29.10/Doubao_installer_2.29.10.exe#/dl.exe",
            "hash": "f2f2b44757dfc1014e80d9c73ebb747c23e209a07af9b9b08f54ff8ba3924fef"
        }
    },
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\dl.exe\" -ArgumentList @('--command=quiet_install', \"--target_dir=$dir\") -Wait",
            "@('Doubao', 'DoubaoLinkRouter') | ForEach-Object { Remove-Item \"$env:LOCALAPPDATA\\$_\" -Recurse -Force -ErrorAction SilentlyContinue }",
            "Remove-Item 'Registry::HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Doubao' -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:USERPROFILE\\Desktop\\豆包.lnk\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\豆包.lnk\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\dl.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "@('Doubao', 'DoubaoLinkRouter') | ForEach-Object { Remove-Item \"$env:LOCALAPPDATA\\$_\" -Recurse -Force -ErrorAction SilentlyContinue }",
            "Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name 'doubao' -Force -ErrorAction SilentlyContinue",
            "Remove-Item 'Registry::HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Doubao' -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Doubao\\Doubao.exe",
            "豆包"
        ]
    ],
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://lf-flow-web-cdn.doubao.com/obj/flow-doubao/doubao_pc/$version/Doubao_installer_$version.exe#/dl.exe"
            }
        }
    }
}
