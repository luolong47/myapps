{
    "##": "夸克浏览器 PC 版（Inno Setup）。用官方 /DIR 参数直接装进 scoop 目录，无需搬运。安装器会通过 Chromium updater 框架注册两个自启项（Run 键 quark / QuarkUpdaterTaskUser*）和一个计划任务，因此安装后与卸载时都要一并拆除，否则更新器会常驻并把夸克装回系统。注意：本包只清理夸克浏览器自身的痕迹，不会触碰同厂商的夸克网盘（QuarkCloudDrive / quark-cloud-drive-updater）。",
    "version": "7.1.5.968",
    "description": "Quark - Alibaba AI browser with built-in Qwen assistant",
    "homepage": "https://quark.cn/",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://umcdn.quark.cn/download/37212/quarkpc/pcquark@homepage_oficial/QuarkPC_V7.1.5.968_pc_pf30002_(zh-cn)_release_(Build3154107-1000-x64).exe#/dl.exe",
            "hash": "6d1ed4309b43aabbd85021058028663edf1bc63a7cfbea5037abc2e985ba4974"
        }
    },
    "installer": {
        "script": [
            "Start-Process -FilePath \"$dir\\dl.exe\" -ArgumentList @('/VERYSILENT', '/SUPPRESSMSGBOXES', '/NORESTART', '/CURRENTUSER', \"/DIR=$dir\\Quark\") -Wait",
            "1..10 | ForEach-Object { Remove-Item \"$env:LOCALAPPDATA\\QuarkUpdater\" -Recurse -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 1200 }",
            "Remove-Item 'Registry::HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{FB7670C2-7F99-426D-B687-21BB585A5C73}_is1' -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\夸克.lnk\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:USERPROFILE\\Desktop\\夸克.lnk\" -Force -ErrorAction SilentlyContinue",
            "(Get-Item 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run').Property | Where-Object { $_ -eq 'quark' -or $_ -like 'QuarkUpdaterTaskUser*' } | ForEach-Object { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name $_ -Force -ErrorAction SilentlyContinue }",
            "Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -like '*QuarkUpdater*' } | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\dl.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "1..6 | ForEach-Object { Remove-Item \"$env:LOCALAPPDATA\\QuarkUpdater\" -Recurse -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 1000 }",
            "Remove-Item 'Registry::HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\{FB7670C2-7F99-426D-B687-21BB585A5C73}_is1' -Recurse -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:APPDATA\\Microsoft\\Windows\\Start Menu\\Programs\\夸克.lnk\" -Force -ErrorAction SilentlyContinue",
            "Remove-Item \"$env:USERPROFILE\\Desktop\\夸克.lnk\" -Force -ErrorAction SilentlyContinue",
            "(Get-Item 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run').Property | Where-Object { $_ -eq 'quark' -or $_ -like 'QuarkUpdaterTaskUser*' } | ForEach-Object { Remove-ItemProperty -Path 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run' -Name $_ -Force -ErrorAction SilentlyContinue }",
            "Get-ScheduledTask -ErrorAction SilentlyContinue | Where-Object { $_.TaskPath -like '*QuarkUpdater*' } | Unregister-ScheduledTask -Confirm:$false -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Quark\\quark.exe",
            "夸克"
        ]
    ]
}
